/var/log/lirc.log {
    daily
    rotate 7
    #copytruncate
    notifempty
    missingok
    dateext
    dateformat .%Y-%m-%d.log

    create 640 smarthome adm
    prerotate
      /usr/bin/monit status lircd >/dev/null 2>&1 && /usr/bin/monit unmonitor lircd || true
      pid_file="/run/lirc/lircd.pid"
      if [ -e "$pid_file" ]; then touch "${pid_file}.ACTIVE"; fi
      /bin/systemctl stop lircd.socket
      /bin/systemctl stop lircd.service
    endscript
    postrotate
      /bin/systemctl try-restart lircd.service 1>/dev/null 2>&1 || true
      pid_file="/run/lirc/lircd.pid.ACTIVE"
      if [ -e "$pid_file" ]; then /usr/bin/rm "${pid_file}" 1>/dev/null; fi
      /usr/bin/monit status lircd >/dev/null 2>&1 && /usr/bin/monit monitor lircd || true
    endscript
}
